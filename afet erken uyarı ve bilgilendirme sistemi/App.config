<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<!--
	  Veritabanı bağlantısı. Kendi bilgisayarınızda "Data Source" kısmını
	  SQL Server örneğinizin adıyla değiştiriniz (örn. .\SQLEXPRESS veya (localdb)\MSSQLLocalDB).
	  Windows kimlik doğrulaması kullanıldığı için parola saklanmaz.
	-->
	<connectionStrings>
		<add name="AfetDB"
			 connectionString="Data Source=HELIN\SQLEXPRESS;Initial Catalog=AfetBilgilendirme;Integrated Security=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

</configuration>
