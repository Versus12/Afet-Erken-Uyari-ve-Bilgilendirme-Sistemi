@model GirisModel
@{
    ViewData["Title"] = "Giriş";
}

<div class="giris-kutusu kart">
    <h1 class="h4 mb-3">Giriş Yap</h1>
    <form asp-controller="Hesap" asp-action="Giris" method="post" novalidate>
        <div asp-validation-summary="All" class="text-danger small mb-2"></div>
        <input type="hidden" asp-for="DonusAdresi" />

        <div class="mb-3">
            <label asp-for="KullaniciAdi" class="form-label"></label>
            <input asp-for="KullaniciAdi" class="form-control" autocomplete="username" autofocus maxlength="50" />
            <span asp-validation-for="KullaniciAdi" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Sifre" class="form-label"></label>
            <input asp-for="Sifre" class="form-control" autocomplete="current-password" maxlength="100" />
            <span asp-validation-for="Sifre" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-ana w-100">Giriş Yap</button>
    </form>
    <p class="mt-3 mb-0 small">
        Hesabınız yok mu? <a asp-controller="Hesap" asp-action="Kayit">Kayıt olun</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
