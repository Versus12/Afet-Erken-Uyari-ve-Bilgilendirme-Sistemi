@model ToplanmaAlaniFormModel
@{
    bool yeni = Model.Alan.AlanId == 0;
    ViewData["Title"] = yeni ? "Yeni Toplanma Alanı" : "Toplanma Alanı Düzenle";
}

<div class="kart" style="max-width: 760px">
    <h1 class="h4 mb-3">@ViewData["Title"]</h1>
    <form asp-controller="ToplanmaAlani" asp-action="Duzenle" method="post">
        <input type="hidden" asp-for="Alan.AlanId" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Alan.BolgeId" class="form-label">Bölge</label>
                <select asp-for="Alan.BolgeId" class="form-select"
                        asp-items="@(new SelectList(Model.Bolgeler, nameof(Bolge.BolgeId), nameof(Bolge.BolgeAdi)))">
                    <option value="0">Bölge seçiniz…</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="Alan.Kapasite" class="form-label">Kapasite (kişi)</label>
                <input asp-for="Alan.Kapasite" class="form-control" type="number" min="1" step="1" />
            </div>
            <div class="col-12">
                <label asp-for="Alan.AlanAdi" class="form-label">Alan adı</label>
                <input asp-for="Alan.AlanAdi" class="form-control" maxlength="150" required />
            </div>
            <div class="col-12">
                <label asp-for="Alan.Adres" class="form-label">Adres</label>
                <input asp-for="Alan.Adres" class="form-control" maxlength="300" required />
            </div>
            <div class="col-md-6">
                <label for="Alan_Enlem" class="form-label">Enlem (isteğe bağlı)</label>
                <input id="Alan_Enlem" name="Alan.Enlem" class="form-control" inputmode="decimal"
                       value="@Model.Alan.Enlem?.ToString(System.Globalization.CultureInfo.InvariantCulture)" placeholder="38.8847" />
            </div>
            <div class="col-md-6">
                <label for="Alan_Boylam" class="form-label">Boylam (isteğe bağlı)</label>
                <input id="Alan_Boylam" name="Alan.Boylam" class="form-control" inputmode="decimal"
                       value="@Model.Alan.Boylam?.ToString(System.Globalization.CultureInfo.InvariantCulture)" placeholder="40.4982" />
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-ana">Kaydet</button>
            <a class="btn btn-outline-secondary" asp-controller="ToplanmaAlani" asp-action="Index">Vazgeç</a>
        </div>
    </form>
</div>
