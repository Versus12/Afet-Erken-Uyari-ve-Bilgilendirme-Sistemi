@model Bolge
@{
    bool yeni = Model.BolgeId == 0;
    ViewData["Title"] = yeni ? "Yeni Bölge" : "Bölge Düzenle";
}

<div class="kart" style="max-width: 640px">
    <h1 class="h4 mb-3">@ViewData["Title"]</h1>
    <form asp-controller="Bolge" asp-action="Duzenle" method="post">
        <input type="hidden" asp-for="BolgeId" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Il" class="form-label">İl</label>
                <input asp-for="Il" class="form-control" maxlength="50" required />
            </div>
            <div class="col-md-6">
                <label asp-for="Ilce" class="form-label">İlçe</label>
                <input asp-for="Ilce" class="form-control" maxlength="50" required />
            </div>
            <div class="col-md-4">
                <label asp-for="RiskSeviyesi" class="form-label">Risk seviyesi</label>
                <select asp-for="RiskSeviyesi" class="form-select">
                    <option value="1">1 - Düşük</option>
                    <option value="2">2</option>
                    <option value="3">3 - Orta</option>
                    <option value="4">4</option>
                    <option value="5">5 - Çok yüksek</option>
                </select>
            </div>
            <div class="col-md-4">
                <label for="Enlem" class="form-label">Enlem (ops.)</label>
                <input id="Enlem" name="Enlem" class="form-control" inputmode="decimal"
                       value="@Model.Enlem?.ToString(System.Globalization.CultureInfo.InvariantCulture)" placeholder="38.8847" />
            </div>
            <div class="col-md-4">
                <label for="Boylam" class="form-label">Boylam (ops.)</label>
                <input id="Boylam" name="Boylam" class="form-control" inputmode="decimal"
                       value="@Model.Boylam?.ToString(System.Globalization.CultureInfo.InvariantCulture)" placeholder="40.4982" />
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-ana">Kaydet</button>
            <a class="btn btn-outline-secondary" asp-controller="Bolge" asp-action="Index">Vazgeç</a>
        </div>
    </form>
</div>
